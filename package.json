{
  "name": "buzz-dkg-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference integration: Buzz (block/buzz) rooms -> OriginTrail DKG v10 layered memory (WM->SWM->VM) with graph-scoped grounded answering",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "verify:dkg-release": "node scripts/verify-dkg-release.mjs",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "nostr-tools": "^2.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
