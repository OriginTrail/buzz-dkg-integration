# A second Buzz community independently discusses the same repository and
# function. Canonical locator identity intentionally converges on the same
# repository and function IRIs even though the named graph and evidence differ.
<urn:test:partner-community:swm:project> {
  <urn:dkg:github:repo:acme/api>
    a github:Repository, software:Repository ;
    schema:name "acme/api" ;
    github:url "https://github.com/acme/api"^^xsd:anyURI .

  <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken>
    a code:Function ;
    schema:name "verifyToken" ;
    code:qualifiedName "auth/token.verifyToken" ;
    software:repository <urn:dkg:github:repo:acme/api> .

  <urn:dkg:github:user:diana>
    a github:User ;
    schema:name "Diana Okafor" .

  <urn:dkg:github:commit:acme/api/f00baa12>
    a github:Commit ;
    schema:name "Reject keys with invalid audience" ;
    schema:dateCreated "2026-07-29T11:05:00Z"^^xsd:dateTime ;
    github:sha "f00baa12" ;
    github:inRepo <urn:dkg:github:repo:acme/api> ;
    github:authoredBy <urn:dkg:github:user:diana> ;
    github:affects <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken> .
}

# An identically named function at the same package/path in another repository
# must remain a different entity and therefore must not join with acme/api.
<urn:test:other-repository:swm:project> {
  <urn:dkg:github:repo:other/api>
    a github:Repository, software:Repository ;
    schema:name "other/api" ;
    github:url "https://github.com/other/api"^^xsd:anyURI .

  <urn:dkg:code:file:github.com%2Fother%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken>
    a code:Function ;
    schema:name "verifyToken" ;
    code:qualifiedName "auth/token.verifyToken" ;
    software:repository <urn:dkg:github:repo:other/api> .

  <urn:dkg:github:user:erin>
    a github:User ;
    schema:name "Erin Chen" .

  <urn:dkg:github:commit:other/api/deadbee1>
    a github:Commit ;
    schema:name "Unrelated verifier implementation" ;
    github:sha "deadbee1" ;
    github:inRepo <urn:dkg:github:repo:other/api> ;
    github:authoredBy <urn:dkg:github:user:erin> ;
    github:affects <urn:dkg:code:file:github.com%2Fother%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken> .
}

