    trust:evidenceSource <urn:nostr:event:2222222222222222222222222222222222222222222222222222222222222222> .

  <urn:buzz-dkg:vouch:5555555555555555555555555555555555555555555555555555555555555555>
    a trust:Vouch ;
    schema:name "Earlier Alice vouch for Bob" ;
    schema:description "Earlier evidence was later withdrawn." ;
