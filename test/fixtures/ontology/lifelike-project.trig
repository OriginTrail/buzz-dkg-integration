    trust:subject <urn:nostr:pubkey:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb> ;
    trust:status "revoked" ;
    trust:scope "channel" ;
    trust:targetVouch "urn:buzz-dkg:vouch:5555555555555555555555555555555555555555555555555555555555555555"^^xsd:anyURI ;
    prov:wasDerivedFrom <urn:nostr:event:6666666666666666666666666666666666666666666666666666666666666666> .

  <urn:nostr:event:4444444444444444444444444444444444444444444444444444444444444444>
    a nostr:Event ;
    nostr:kind 1985 ;
    nostr:createdAt "2026-07-30T13:00:00Z"^^xsd:dateTime ;
    nostr:content "Bob reviewed the token changes carefully and caught the rollback edge case." ;
    nostr:sig "abababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab" ;
    nostr:tags "[[\"h\",\"channel-one\"],[\"L\",\"buzz.wot\"],[\"l\",\"vouch\",\"buzz.wot\"],[\"p\",\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"]]" ;
    prov:wasAttributedTo <urn:nostr:pubkey:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa> .

  <urn:nostr:event:5555555555555555555555555555555555555555555555555555555555555555>
    a nostr:Event ;
    nostr:kind 1985 ;
    nostr:createdAt "2026-07-25T13:00:00Z"^^xsd:dateTime ;
    nostr:content "Earlier evidence was later withdrawn." ;
    nostr:sig "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd" ;
    nostr:tags "[[\"h\",\"channel-one\"],[\"L\",\"buzz.wot\"],[\"l\",\"vouch\",\"buzz.wot\"],[\"p\",\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"]]" ;
