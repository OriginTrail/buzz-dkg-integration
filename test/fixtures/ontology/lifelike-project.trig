<urn:test:acme-api:swm:project> {
  <urn:dkg:github:repo:acme/api>
    a github:Repository, software:Repository ;
    schema:name "acme/api" ;
    github:url "https://github.com/acme/api"^^xsd:anyURI .

  <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth>
    a code:Package ;
    schema:name "Authentication gateway" ;
    software:repository <urn:dkg:github:repo:acme/api> .

  <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts>
    a code:File ;
    schema:name "token.ts" ;
    code:path "src/token.ts" ;
    code:package <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> ;
    software:repository <urn:dkg:github:repo:acme/api> .

  <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken>
    a code:Function ;
    schema:name "verifyToken" ;
    code:qualifiedName "auth/token.verifyToken" ;
    code:definedIn <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts> ;
    software:repository <urn:dkg:github:repo:acme/api> .

  <urn:dkg:github:user:alice>
    a github:User ;
    schema:name "Alice Nguyen" .

  <urn:dkg:github:user:bob>
    a github:User ;
    schema:name "Bob Ortiz" .

  <urn:dkg:github:user:carol>
    a github:User ;
    schema:name "Carol Singh" .

  <urn:dkg:github:commit:acme/api/a1b2c3d4>
    a github:Commit ;
    schema:name "Implement short-lived access tokens" ;
    schema:dateCreated "2026-07-14T10:15:00Z"^^xsd:dateTime ;
    github:sha "a1b2c3d4" ;
    github:inRepo <urn:dkg:github:repo:acme/api> ;
    github:authoredBy <urn:dkg:github:user:alice> ;
    github:affects
      <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> ,
      <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts> ,
      <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken> .

  <urn:dkg:github:commit:acme/api/e5f6a7b8>
    a github:Commit ;
    schema:name "Return typed token verification errors" ;
    schema:dateCreated "2026-07-21T16:40:00Z"^^xsd:dateTime ;
    github:sha "e5f6a7b8" ;
    github:inRepo <urn:dkg:github:repo:acme/api> ;
    github:authoredBy <urn:dkg:github:user:bob> ;
    github:affects
      <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> ,
      <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken> .

  <urn:dkg:github:pr:acme/api/42>
    a github:PullRequest ;
    schema:name "Rotate refresh tokens and shorten access-token lifetime" ;
    github:number 42 ;
    github:state "merged" ;
    github:containsCommit <urn:dkg:github:commit:acme/api/a1b2c3d4> ;
    github:affects <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> .

  <urn:dkg:github:pr:acme/api/45>
    a github:PullRequest ;
    schema:name "Make token verification failures typed" ;
    github:number 45 ;
    github:state "merged" ;
    github:containsCommit <urn:dkg:github:commit:acme/api/e5f6a7b8> ;
    github:affects <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> .

  <urn:dkg:decision:short-lived-jwt>
    a decisions:Decision ;
    schema:name "Use short-lived JWT access tokens" ;
    decisions:status "accepted" ;
    decisions:context "Long-lived bearer tokens made credential exposure too costly." ;
    decisions:outcome "Use 15-minute access tokens with rotating refresh tokens." ;
    decisions:consequences "Clients must handle refresh rotation and replay detection." ;
    decisions:affects <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> ;
    decisions:recordedIn <urn:dkg:github:pr:acme/api/42> ;
    decisions:implementedBy <urn:dkg:github:commit:acme/api/a1b2c3d4> ;
    prov:wasAttributedTo <urn:nostr:pubkey:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa> ;
    prov:wasDerivedFrom
      <urn:nostr:event:1111111111111111111111111111111111111111111111111111111111111111> ,
      <urn:nostr:event:2222222222222222222222222222222222222222222222222222222222222222> .

  <urn:dkg:decision:typed-auth-errors>
    a decisions:Decision ;
    schema:name "Represent verification failures as typed errors" ;
    decisions:status "accepted" ;
    decisions:context "Callers could not distinguish expiry from malformed tokens." ;
    decisions:outcome "Return ExpiredToken, InvalidSignature, and MalformedToken variants." ;
    decisions:affects <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> ;
    decisions:recordedIn <urn:dkg:github:pr:acme/api/45> ;
    decisions:implementedBy <urn:dkg:github:commit:acme/api/e5f6a7b8> ;
    prov:wasAttributedTo <urn:nostr:pubkey:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb> ;
    prov:wasDerivedFrom <urn:nostr:event:3333333333333333333333333333333333333333333333333333333333333333> .

  <urn:dkg:task:update-client-refresh-docs>
    a tasks:Task ;
    schema:name "Document refresh-token rotation for SDK maintainers" ;
    tasks:status "todo" ;
    tasks:priority "p1" ;
    tasks:assignee <urn:dkg:github:user:carol> ;
    tasks:relatedDecision <urn:dkg:decision:short-lived-jwt> ;
    tasks:touches <urn:dkg:code:package:github.com%2Facme%2Fapi/%40acme%2Fauth> ;
    prov:wasDerivedFrom <urn:nostr:event:2222222222222222222222222222222222222222222222222222222222222222> .

  <urn:dkg:software:test:refresh-token-replay>
    a software:TestCase ;
    schema:name "rejects refresh-token replay" ;
    software:tests <urn:dkg:code:file:github.com%2Facme%2Fapi/%40acme%2Fauth/src%2Ftoken.ts#function:verifyToken> .

  <urn:dkg:software:test-run:ci-8812>
    a software:TestRun ;
    schema:name "CI run 8812" ;
    schema:dateCreated "2026-07-14T10:22:00Z"^^xsd:dateTime ;
    software:executedTest <urn:dkg:software:test:refresh-token-replay> ;
    software:result "passed" ;
    software:supports <urn:dkg:github:commit:acme/api/a1b2c3d4> ;
    prov:wasDerivedFrom <urn:nostr:event:2222222222222222222222222222222222222222222222222222222222222222> .
}

<urn:test:acme-api:swm:trust> {
  <urn:buzz-dkg:vouch:alice-for-bob>
    a trust:Vouch ;
    schema:name "Alice vouches for Bob's release work" ;
    schema:description "Bob reviewed the token changes carefully and caught the rollback edge case." ;
    trust:issuer <urn:nostr:pubkey:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa> ;
    trust:subject <urn:nostr:pubkey:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb> ;
    trust:status "active" ;
    trust:scope "channel" ;
    trust:supportedBy <urn:buzz-dkg:evidence-reference:alice-for-bob:1> ;
    prov:wasDerivedFrom <urn:nostr:event:4444444444444444444444444444444444444444444444444444444444444444> .

  <urn:buzz-dkg:evidence-reference:alice-for-bob:1>
