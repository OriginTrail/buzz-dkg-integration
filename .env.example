# Buzz relay
BDI_BUZZ_HTTP=http://127.0.0.1:9440
BDI_BUZZ_WS=ws://127.0.0.1:9440
# Service member identity (hex secret key) — generate fresh; never reuse spike keys
BDI_SERVICE_KEY=<hex64-secret-key>
# In-channel mention handle: the bot answers "@<handle> distill|ask …"
BDI_MENTION_HANDLE=dkg

# DKG node (a stock v10 edge node serves on :9200; the isolated devnet in
# phase0/ uses :9420 — see README "Run (isolated stack)")
BDI_DKG_API=http://127.0.0.1:9200
# Either a token path (preferred) or the raw token. The node writes its bearer
# token to <DKG_HOME>/auth.token (the daemon reads the last non-comment line).
BDI_DKG_TOKEN_PATH=<path-to-auth.token>
#BDI_DKG_TOKEN=<bearer-token>

# channel↔context-graph bindings + authorized promoters (JSON file; see README)
BDI_BINDINGS_PATH=./bindings.json

# 'disabled' (default) | 'devnet' (node must report evm:31337) |
# 'mainnet' (node must report base:8453; bounded by BDI_MAX_PUBLISHES_PER_DAY).
# WARNING: 'mainnet' spends real ETH and writes irreversibly to Base on every
# approved publish. Leave 'disabled' unless you intend on-chain publication.
BDI_PUBLISH_MODE=disabled
# mainnet guardrail: max daemon-initiated VM publications per rolling 24h.
# Must be a non-negative number — a non-numeric value fails startup (it would
# otherwise remove the only spend ceiling).
BDI_MAX_PUBLISHES_PER_DAY=5

# Reaction emoji an authorized promoter uses to approve a VM publish
BDI_APPROVAL_EMOJI=✅
# SQLite path for the durable op/ask/approval state (created if absent)
BDI_DB_PATH=./data/daemon.db
# Log level: error | warn | info | debug
BDI_LOG_LEVEL=info
