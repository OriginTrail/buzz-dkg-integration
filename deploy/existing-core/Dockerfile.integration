FROM node:22.23.0-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force

COPY src ./src
COPY scripts/mvp-smoke.mjs ./scripts/mvp-smoke.mjs
COPY scripts/smoke-command.mjs ./scripts/smoke-command.mjs
COPY scripts/bootstrap ./scripts/bootstrap
COPY phase0/bridge/lib/nostr.mjs ./phase0/bridge/lib/nostr.mjs
COPY deploy/existing-core/bootstrap.mjs ./deploy/existing-core/bootstrap.mjs

USER node

CMD ["node", "--experimental-strip-types", "src/index.ts"]
