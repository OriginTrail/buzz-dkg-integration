diff --git a/packages/node-ui/src/ui/hooks/useDeepLink.ts b/packages/node-ui/src/ui/hooks/useDeepLink.ts
new file mode 100644
index 000000000..f4bcae8e7
--- /dev/null
+++ b/packages/node-ui/src/ui/hooks/useDeepLink.ts
@@ -0,0 +1,68 @@
+import { useEffect } from 'react';
+import { useTabsStore } from '../stores/tabs.js';
+
+/**
+ * URL deep-linking into the node UI. External surfaces (chat receipts, docs,
+ * other tools) can land a viewer on a specific Context Graph, memory layer,
+ * or entity by linking:
+ *
+ *   /ui/?cg=<contextGraphId>                      → the CG's project tab
+ *   /ui/?cg=<id>&layer=swm                        → that CG's SWM layer view
+ *   /ui/?cg=<id>&entity=<entityUri>               → the entity detail, opened
+ *                                                   inside the project tab via
+ *                                                   the existing
+ *                                                   `v10:open-entity` event
+ *
+ * The entity dispatch retries briefly because the ProjectView mounts (and
+ * attaches its listener) only after the tab opens; the `v10:open-entity-ack`
+ * event stops the retries as soon as a listener has actually handled it, so
+ * a user closing the detail is never fought by a stale retry loop.
+ */
+export function useDeepLink(): void {
+  const openTab = useTabsStore((s) => s.openTab);
+
+  useEffect(() => {
+    const params = new URLSearchParams(window.location.search);
+    const cg = params.get('cg');
+    if (!cg) return;
+    const layer = params.get('layer');
+    const entity = params.get('entity');
+
+    const shortName = cg.split('/').pop() || cg;
+    openTab({ id: `project:${cg}`, label: shortName.slice(0, 24), closable: true });
+
+    if (entity) {
+      let tries = 0;
+      let done = false;
+      const onAck = () => {
+        done = true;
+        window.removeEventListener('v10:open-entity-ack', onAck);
+      };
+      window.addEventListener('v10:open-entity-ack', onAck);
+      const timer = window.setInterval(() => {
+        if (done || tries >= 12) {
+          window.clearInterval(timer);
+          window.removeEventListener('v10:open-entity-ack', onAck);
+          return;
+        }
+        tries += 1;
+        window.dispatchEvent(
+          new CustomEvent('v10:open-entity', {
+            detail: { contextGraphId: cg, entityUri: entity },
+          }),
+        );
+      }, 500);
+    } else if (layer === 'wm' || layer === 'swm' || layer === 'vm') {
+      openTab({
+        id: `${layer}:${cg}`,
+        label: `${layer.toUpperCase()} · ${shortName.slice(0, 16)}`,
+        closable: true,
+      });
+    }
+
+    // Strip the params so a manual reload returns to the user's own state
+    // instead of re-running the deep link.
+    window.history.replaceState(null, '', window.location.pathname);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+}
