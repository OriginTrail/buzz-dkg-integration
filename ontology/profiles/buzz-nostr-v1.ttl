@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <http://schema.org/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix memory:  <http://dkg.io/ontology/memory/> .
@prefix buzz:    <https://w3id.org/buzz-dkg/buzz#> .
@prefix nostr:   <https://w3id.org/buzz-dkg/nostr#> .

<https://w3id.org/buzz-dkg/profile/buzz-nostr/1>
  a owl:Ontology ;
  dcterms:title "Buzz and Nostr DKG memory adapter profile" ;
  dcterms:description "Application provenance for semantic memories derived from signed Buzz/Nostr channel events." ;
  owl:versionInfo "1.0.0-beta" ;
  dcterms:created "2026-08-09"^^xsd:date ;
  owl:imports
    <http://dkg.io/ontology/profile/dkg-memory/1> ,
    <http://www.w3.org/ns/prov#> .

buzz:AgentMemory
  a owl:Class ;
  rdfs:subClassOf memory:Memory ;
  rdfs:label "Buzz agent semantic memory" .

buzz:AgentMemoryProposal
  a owl:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "Buzz agent memory proposal activity" .

buzz:Channel
  a owl:Class ;
  rdfs:subClassOf schema:Conversation ;
  rdfs:label "Buzz channel" .

nostr:Event
  a owl:Class ;
  rdfs:subClassOf prov:Entity, schema:Message ;
  rdfs:label "Signed Nostr event" .

buzz:channel
  a owl:ObjectProperty ;
  rdfs:domain buzz:AgentMemory ;
  rdfs:range buzz:Channel .

buzz:proposalEvent
  a owl:ObjectProperty ;
  rdfs:domain buzz:AgentMemory ;
  rdfs:range nostr:Event .

buzz:model a owl:DatatypeProperty ; rdfs:range xsd:string .
buzz:promptVersion a owl:DatatypeProperty ; rdfs:range xsd:string .

nostr:kind a owl:DatatypeProperty ; rdfs:domain nostr:Event ; rdfs:range xsd:integer .
nostr:createdAt a owl:DatatypeProperty ; rdfs:domain nostr:Event ; rdfs:range xsd:dateTime .
nostr:content a owl:DatatypeProperty ; rdfs:domain nostr:Event ; rdfs:range xsd:string .
nostr:sig a owl:DatatypeProperty ; rdfs:domain nostr:Event ; rdfs:range xsd:string .
nostr:tags a owl:DatatypeProperty ; rdfs:domain nostr:Event ; rdfs:range xsd:string .
nostr:threadIndex a owl:DatatypeProperty ; rdfs:domain nostr:Event ; rdfs:range xsd:integer .
nostr:pubkeyHex a owl:DatatypeProperty ; rdfs:range xsd:string .

